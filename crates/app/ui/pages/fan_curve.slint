                        CurveStepper { horizontal-stretch: 1; label: "R"; value: root.rpm-cpu-rpm-5; lower: 0; upper: 8000; step: 100; suffix: ""; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-cpu-rpm-5 = v; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 16px; text: "7"; color: Palette.text-faint; font-family: "Cascadia Mono"; font-size: 9px; vertical-alignment: center; }
                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-cpu-temp-6; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-cpu-temp-6 = v; } }
