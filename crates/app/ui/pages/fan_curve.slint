                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-cpu-temp-4; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-cpu-temp-4 = v; } }
