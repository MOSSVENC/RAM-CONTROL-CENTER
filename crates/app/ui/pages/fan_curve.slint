            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 16px;
                spacing: 5px;
                SectionTitle { text: @tr("GPU fan"); }
                Hairline { }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 16px; text: "1"; color: Palette.text-faint; font-family: "Cascadia Mono"; font-size: 9px; vertical-alignment: center; }
                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-gpu-temp-0; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-gpu-temp-0 = v; } }
                        CurveStepper { horizontal-stretch: 1; label: "R"; value: root.rpm-gpu-rpm-0; lower: 0; upper: 8000; step: 100; suffix: ""; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-gpu-rpm-0 = v; } }
