                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-gpu-temp-5; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-gpu-temp-5 = v; } }
                        CurveStepper { horizontal-stretch: 1; label: "R"; value: root.rpm-gpu-rpm-5; lower: 0; upper: 8000; step: 100; suffix: ""; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-gpu-rpm-5 = v; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 16px; text: "7"; color: Palette.text-faint; font-family: "Cascadia Mono"; font-size: 9px; vertical-alignment: center; }
                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-gpu-temp-6; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-gpu-temp-6 = v; } }
