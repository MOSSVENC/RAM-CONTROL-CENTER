                        CurveStepper { horizontal-stretch: 1; label: "T"; value: root.rpm-cpu-temp-9; lower: 0; upper: 100; step: 1; suffix: "°C"; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-cpu-temp-9 = v; } }
                        CurveStepper { horizontal-stretch: 1; label: "R"; value: root.rpm-cpu-rpm-9; lower: 0; upper: 8000; step: 100; suffix: ""; enabled: root.rpm-editable && !root.busy; changed(v) => { root.rpm-cpu-rpm-9 = v; } }
