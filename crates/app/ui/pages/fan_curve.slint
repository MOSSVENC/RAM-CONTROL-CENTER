    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;
        Text {
            text: @tr("Each edited point updates the up/down temperature and RPM pair. Vendor reserved bytes, duties, and timing fields are preserved.");
            color: Palette.text-faint;
            font-family: "Microsoft YaHei UI";
            font-size: 10px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        StageButton {
            width: 220px;
            text: root.busy ? @tr("Writing fan curve…") : @tr("Apply ten-point curve");
            primary: true;
            enabled: !root.busy && root.rpm-editable;
            clicked => { root.apply-rpm-curve(); }
