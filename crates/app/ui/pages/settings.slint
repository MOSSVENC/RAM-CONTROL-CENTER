import { Palette } from "../theme.slint";
import {
    ChromeButton, ChoiceChip, CurveStepper, DataLabel, DataValue, FanOption, FanReadout,
    FieldInput, Hairline, InfoRow, MetricBar, MicroLabel, NavGlyph, NavItem, PowerOption,
    ReadoutRow, SectionTitle, SignalDot, StageButton, ToggleStatusRow,
    SegmentedChoice,
} from "../components.slint";

                        export component SettingsPage inherits VerticalLayout {
    in property <int> selected-page: 0;
    in-out property <bool> language-zh: true;
    in property <string> renderer-text: "检测中";
    in property <bool> startup-enabled: false;
    callback set-startup(bool);
    callback set-language(bool);
    callback set-theme(bool);

    spacing: 18px;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: @tr("Settings");
            color: Palette.text;
            font-family: "Bahnschrift";
            font-size: 27px;
            font-weight: 600;
        }
        Text {
            text: @tr("Language, appearance, and the active graphics path. Changes apply immediately.");
            color: Palette.text-dim;
            font-family: "Microsoft YaHei UI";
            font-size: 12px;
        }
    }

    HorizontalLayout {
        spacing: 18px;
        vertical-stretch: 1;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 16px;
            background: Palette.surface-gradient;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                SectionTitle { text: @tr("Language & appearance"); }
                Hairline {}

                Text {
                    text: @tr("Language");
                    color: Palette.text;
                    font-family: "Microsoft YaHei UI";
                    font-size: 13px;
                    font-weight: 600;
                }
                SegmentedChoice {
                    width: 300px;
                    labels: ["简体中文", "English"];
                    selected-index: root.language-zh ? 0 : 1;
                    selected(index) => { root.set-language(index == 0); }
                }
                Text {
                    text: @tr("The interface and diagnostic labels switch immediately. Technical vendor names stay unchanged.");
                    color: Palette.text-faint;
                    font-family: "Microsoft YaHei UI";
                    font-size: 10px;
                    wrap: word-wrap;
                }

                Rectangle { height: 4px; }

                Text {
                    text: @tr("Theme");
                    color: Palette.text;
                    font-family: "Microsoft YaHei UI";
                    font-size: 13px;
                    font-weight: 600;
                }
                SegmentedChoice {
                    width: 330px;
                    labels: [
                        root.language-zh ? "浅色 · 冷瓷" : "Light · Porcelain",
                        root.language-zh ? "深色 · 石墨" : "Dark · Graphite",
                    ];
                    selected-index: Palette.dark ? 1 : 0;
                    selected(index) => { root.set-theme(index == 1); }
                }
                Text {
                    text: @tr("Switching theme uses a short cross-fade instead of an abrupt color jump.");
                    color: Palette.text-faint;
                    font-family: "Microsoft YaHei UI";
                    font-size: 10px;
                    wrap: word-wrap;
                }

                Rectangle { height: 4px; }
                Text {
                    text: @tr("Resident control");
                    color: Palette.text;
                    font-family: "Microsoft YaHei UI";
                    font-size: 13px;
                    font-weight: 600;
                }
                ToggleStatusRow {
                    label: @tr("Start with Windows");
                    value: root.startup-enabled;
                    known: true;
                    busy: false;
                    toggled(value) => { root.set-startup(value); }
                }
                Text {
                    text: @tr("Uses the current-user Run key to start the same executable in the tray at logon.");
                    color: Palette.text-faint;
                    font-family: "Microsoft YaHei UI";
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle {
            width: 430px;
            border-radius: 16px;
            background: Palette.surface-gradient;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    SectionTitle { text: @tr("Graphics renderer"); }
                    Rectangle { horizontal-stretch: 1; }
                    SignalDot { active: root.renderer-text != "检测中"; tone: Palette.green; }
                }
                Hairline {}
                InfoRow { label: @tr("Backend"); value: root.renderer-text; value-tone: Palette.cyan; }
                InfoRow { label: @tr("Acceleration"); value: @tr("GPU compositing"); value-tone: Palette.green; }
                InfoRow { label: @tr("Animation"); value: @tr("Slide veil · lift · scale"); }
                Text {
                    text: @tr("Neo Control uses the Slint winit renderer. The scene is composed by the GPU; the hardware worker only samples telemetry off the UI thread.");
                    color: Palette.text-dim;
                    font-family: "Microsoft YaHei UI";
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: @tr("If Windows graphics settings assign a specific adapter, the active backend string above remains the authoritative runtime report.");
                    color: Palette.text-faint;
                    font-family: "Microsoft YaHei UI";
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
