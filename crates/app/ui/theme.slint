export global Palette {
    in-out property <bool> dark: false;
    in-out property <float> blend: 0;

    out property <color> base: #12151E.mix(#E8ECF3, blend);
    out property <color> rail: #171A24.mix(#DDE3EE, blend);
    out property <color> surface: #1C202C.mix(#F7F9FD, blend);
    out property <color> surface-hi: #252A38.mix(#FFFFFF, blend);
    out property <color> line: #303647.mix(#C8D1DF, blend);
    out property <color> line-hi: #485169.mix(#95A2B8, blend);
    out property <color> text: #F4F3FA.mix(#141824, blend);
    out property <color> text-dim: #A6AABC.mix(#586578, blend);
    out property <color> text-faint: #73798F.mix(#8591A5, blend);
    out property <color> cyan: #A7A9FF.mix(#3E50D8, blend);
    out property <color> amber: #FF86A9.mix(#D93B70, blend);
    out property <color> green: #72E6BC.mix(#078A66, blend);
    out property <color> red: #FF818B.mix(#D62F4E, blend);
    out property <color> panel-hover: #242938.mix(#EEF2F9, blend);
    out property <color> panel-selected: #292D46.mix(#E2E6FB, blend);
    out property <color> track: #2B3142.mix(#D6DDE8, blend);
    out property <color> accent-soft: #2C3154.mix(#DDE2FF, blend);
    out property <color> rose-soft: #3B2532.mix(#FCE3EA, blend);
    out property <color> green-soft: #19372F.mix(#DDF5EC, blend);
    out property <color> red-soft: #3B242A.mix(#FCE2E6, blend);
    out property <color> accent-hover: #BABCFF.mix(#5264EE, blend);
    out property <color> primary-text: #12151E.mix(#F9FAFF, blend);

    out property <brush> base-gradient: @linear-gradient(
        135deg,
        #0F121A.mix(#E9EDF5, blend) 0%,
        #141824.mix(#F4F6FB, blend) 55%,
        #11141C.mix(#E6EAF2, blend) 100%
    );
    out property <brush> rail-gradient: @linear-gradient(
        180deg,
        #1A1D29.mix(#E2E7F1, blend) 0%,
        #151822.mix(#D9E0EB, blend) 100%
    );
    out property <brush> surface-gradient: @linear-gradient(
        145deg,
        #202532.mix(#FFFFFF, blend) 0%,
        #191D28.mix(#F3F6FC, blend) 100%
    );
    out property <brush> accent-gradient: @linear-gradient(
        135deg,
        #8D90FF.mix(#3F50D8, blend) 0%,
        #FF83A6.mix(#7A4BDB, blend) 100%
    );
    out property <brush> page-veil-gradient: @linear-gradient(
        90deg,
        #171B2C.mix(#F1F4FF, blend) 0%,
        #20243D.mix(#DDE4FF, blend) 52%,
        #2B2350.mix(#C8D3FF, blend) 100%
    );
}
