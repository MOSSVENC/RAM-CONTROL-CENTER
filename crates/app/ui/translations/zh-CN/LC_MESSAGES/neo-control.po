msgstr "0xNN 或十进制"

msgid "Capture key"
msgstr "捕获按键"

msgid "Cancel capture"
msgstr "取消捕获"

msgid "Display name"
msgstr "显示名称"

msgid "Shown in the binding list"
msgstr "显示在绑定列表中"

msgid "Listening for one key or mouse button. The captured input is swallowed."
msgstr "正在监听一个按键或鼠标按钮。捕获到的输入会被拦截。"

msgid "Capture accepts keyboard keys and the five standard mouse buttons."
msgstr "可捕获键盘按键和五种标准鼠标按钮。"

msgid "Action"
msgstr "动作"

msgid "Hotkey"
msgstr "快捷键"

msgid "Launch"
msgstr "启动"

msgid "Text"
msgstr "文本"

msgid "Disable"
msgstr "禁用"

msgid "Hotkey sequence"
msgstr "快捷键组合"

msgid "Target path"
msgstr "启动目标"

msgid "Text to type"
msgstr "输入文本"

msgid "Ctrl+Shift+S, or Win+R  (space separates sequences)"
msgstr "Ctrl+Shift+S，或 Win+R（空格分隔多个组合）"

msgid "C:\\Tools\\app.exe"
msgstr "C:\\Tools\\app.exe"

msgid "Chinese and Unicode text are supported"
msgstr "支持中文和 Unicode 文本"

msgid "Leaving this empty keeps an existing macro unchanged. New hotkey bindings need a sequence."
msgstr "编辑现有按键宏时留空可保持原动作；新快捷键绑定必须填写。"

msgid "This trigger is swallowed and performs no action."
msgstr "此触发会被拦截，不执行任何动作。"

msgid "Delete"
msgstr "删除"

msgid "Save binding"
msgstr "保存绑定"

msgid "Each chord is sent in order. Modifier keys are released in reverse order."
msgstr "每个组合键会按顺序发送，修饰键按相反顺序释放。"

msgid "The target opens through the Windows shell when the trigger fires."
msgstr "触发时，目标会通过 Windows Shell 打开。"

msgid "The text is typed into whichever window has focus when the trigger fires."
msgstr "触发时，文本会输入到当前获得焦点的窗口。"

msgid "Use this to reserve a key or mouse button without an action."
msgstr "用于保留一个按键或鼠标按钮，但不执行动作。"

msgid "Trigger devices"
msgstr "触发设备"

msgid "Display care"
msgstr "显示保护"

msgid "Windows presence, screen timeout, and screen-saver controls recovered from the CC4.0 OLED page."
msgstr "从 CC4.0 OLED 页面恢复的 Windows 界面、显示器超时与屏幕保护控制。"

msgid "Windows surface"
msgstr "Windows 界面"

msgid "These changes are applied immediately and read back from Windows."
msgstr "这些更改会立即应用，并从 Windows 读回验证。"

msgid "Automatically hide taskbar"
msgstr "自动隐藏任务栏"

msgid "Taskbar transparency"
msgstr "任务栏透明效果"

msgid "Dark appearance"
msgstr "深色外观"

msgid "The panel reports OLED. Static taskbar elements and long display-on sessions are the main burn-in risks."
msgstr "面板报告为 OLED。静态任务栏元素和长时间亮屏是主要的烧屏风险。"

msgid "The panel reports LCD. Pixel shifting and OLED refresh routines are not exposed; the Windows protection controls remain available."
msgstr "面板报告为 LCD。像素偏移与 OLED 刷新例程不会显示；Windows 保护控制仍然可用。"

msgid "CC4.0 stores these preferences in AppSettings offsets 45–47 and applies the corresponding Windows state itself."
msgstr "CC4.0 将这些偏好保存在 AppSettings 偏移 45–47，并直接应用对应的 Windows 状态。"

msgid "Timing & screen saver"
msgstr "时间与屏幕保护"

msgid "Monitor timeout"
msgstr "显示器超时"

msgid "AC"
msgstr "交流电"

msgid "BATTERY"
msgstr "电池"

msgid "A value of 0 means the display never turns off automatically."
msgstr "值为 0 表示显示器不会自动关闭。"

msgid "Apply monitor timeouts"
msgstr "应用显示器超时"

msgid "Screen saver"
msgstr "屏幕保护程序"

msgid "None"
msgstr "无"

msgid "Blank"
msgstr "空白"

msgid "Bubbles"
msgstr "气泡"

msgid "Mystify"
msgstr "变幻线"

msgid "Photos"
msgstr "照片"

msgid "Ribbons"
msgstr "彩带"

msgid "3D Text"
msgstr "3D 文字"

msgid "WAIT"
msgstr "等待"

msgid "Apply screen saver"
msgstr "应用屏幕保护程序"

msgid "CC4.0 uses the Windows screen-saver list and persists the selected mode at AppSettings offset 48. The timeout is written to both Windows and the desktop registry."
msgstr "CC4.0 使用 Windows 屏幕保护列表，并将所选模式保存到 AppSettings 偏移 48。超时会同时写入 Windows 与桌面注册表。"

msgid "Profile name"
msgstr "配置名称"

msgid "Name shown in the profile list"
msgstr "显示在配置列表中的名称"

msgid "Save name"
msgstr "保存名称"

msgid "New"
msgstr "新建"

msgid "Confirm"
msgstr "确认"
