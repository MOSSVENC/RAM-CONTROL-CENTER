import { Palette } from "theme.slint";
export { Palette }
import {
    ChromeButton,
    ChoiceChip,
    CurveStepper,
    DataLabel,
    DataValue,
    FanOption,
    FanReadout,
    FieldInput,
    Hairline,
    InfoRow,
    MetricBar,
    MicroLabel,
    NavGlyph,
    NavItem,
    PowerOption,
    ReadoutRow,
    SectionTitle,
    SignalDot,
    StageButton,
    ToggleStatusRow,
} from "components.slint";
import { QuietDialog } from "dialogs/quiet.slint";
import { FlexiKeyEditor } from "dialogs/flexikey_editor.slint";
import { OverviewPage } from "pages/overview.slint";
import { PerformancePage } from "pages/performance.slint";
import { CoolingPage } from "pages/cooling.slint";
import { BatteryPage } from "pages/battery.slint";
import { SystemPage } from "pages/system.slint";
import { SettingsPage } from "pages/settings.slint";
import { LightingPage } from "pages/lighting.slint";
import { InputIoPage } from "pages/input_io.slint";
import { FanCurvePage } from "pages/fan_curve.slint";
import { FlexiKeyPage } from "pages/flexikey.slint";
import { DisplayCarePage } from "pages/display_care.slint";

export component MainWindow inherits Window {
    title: @tr("NEO CONTROL");
    icon: @image-url("../../../assets/neo_control_logo.svg");
    width: 1180px;
    height: 820px;
    background: Palette.base-gradient;
    default-font-family: "Bahnschrift";
    default-font-size: 13px;

    in property <int> selected-page: 0;
    in-out property <int> navigation-page: 0;
    in-out property <int> requested-power-mode: 2;
    in-out property <int> requested-fan-mode: 0;
    in property <bool> busy: false;
    in-out property <bool> language-zh: true;
    in-out property <float> page-opacity: 1.0;
    in-out property <float> page-shift: 0.0;
    in-out property <float> page-scale: 1.0;
    in-out property <duration> page-fade-duration: 150ms;
    in-out property <duration> page-motion-duration: 220ms;
    in-out property <float> page-veil-x: 1.0;
    in-out property <bool> page-veil-visible: false;
    in-out property <duration> page-veil-duration: 140ms;
    in-out property <float> theme-flash: 0.0;
    in-out property <bool> quiet-dialog-open: false;
    in property <bool> transport-ready: false;
    in property <string> transport-label: @tr("Connecting to DCHU");
    in property <string> transport-detail: @tr("Opening the signed AcpiBridge device");
    in property <string> status-message: "";
    in property <int> status-tone: 0;

    in property <string> cpu-temp: "--°C";
    in property <string> gpu-temp: "--°C";
    in property <string> cpu-rpm: "----";
    in property <string> gpu-rpm: "----";
    in property <string> fan3-rpm: "----";
    in property <string> fan4-rpm: "----";
    in property <string> fan3-temp: "--";
    in property <string> fan4-temp: "--";
    in property <string> cpu-duty: "--";
    in property <string> gpu-duty: "--";
    in property <string> fan3-duty: "--";
    in property <string> fan4-duty: "--";
    in property <int> cpu-load: 0;
    in property <int> gpu-load: 0;
    in property <int> gpu-memory-load: 0;
    in property <int> memory-load: 0;
    in property <int> disk-load: 0;
    in property <string> cpu-clock: "--";
    in property <string> cpu-clock-max: "--";
    in property <string> gpu-clock: "--";
    in property <string> gpu-clock-max: "--";
    in property <string> memory-text: @tr("--");
    in property <string> disk-text: @tr("--");
    in property <string> gpu-memory-text: @tr("--");
    in property <int> power-mode: 2;
    in property <string> power-label: @tr("Performance");
    in property <bool> power-quiet-supported: false;
    in property <bool> power-saving-supported: false;
    in property <bool> power-performance-supported: true;
    in property <bool> power-entertainment-supported: true;
    in property <int> fan-mode: 0;
    in property <string> fan-label: @tr("Automatic");
    in property <bool> slow-fan-active: false;
    in property <bool> turbo-fan-active: false;
    in property <bool> slow-fan-supported: false;
    in property <bool> turbo-fan-supported: false;
    in property <bool> turbo-fan-eligible: false;
    in property <bool> curve-available: false;
    in property <bool> rpm-fan-control: false;
    in property <int> fan-offset-current: 0;
    in-out property <int> fan-offset-requested: 0;
    in property <string> curve-current-text: @tr("Reading runtime table");
    in property <string> rpm-curve-text: @tr("Reading ten-point fan table");
    in property <bool> rpm-editable: false;
    in-out property <int> rpm-cpu-temp-0: 0;
    in-out property <int> rpm-cpu-temp-1: 0;
    in-out property <int> rpm-cpu-temp-2: 0;
    in-out property <int> rpm-cpu-temp-3: 0;
    in-out property <int> rpm-cpu-temp-4: 0;
    in-out property <int> rpm-cpu-temp-5: 0;
    in-out property <int> rpm-cpu-temp-6: 0;
    in-out property <int> rpm-cpu-temp-7: 0;
    in-out property <int> rpm-cpu-temp-8: 0;
    in-out property <int> rpm-cpu-temp-9: 0;
    in-out property <int> rpm-cpu-rpm-0: 0;
    in-out property <int> rpm-cpu-rpm-1: 0;
    in-out property <int> rpm-cpu-rpm-2: 0;
    in-out property <int> rpm-cpu-rpm-3: 0;
    in-out property <int> rpm-cpu-rpm-4: 0;
    in-out property <int> rpm-cpu-rpm-5: 0;
    in-out property <int> rpm-cpu-rpm-6: 0;
    in-out property <int> rpm-cpu-rpm-7: 0;
    in-out property <int> rpm-cpu-rpm-8: 0;
    in-out property <int> rpm-cpu-rpm-9: 0;
    in-out property <int> rpm-gpu-temp-0: 0;
    in-out property <int> rpm-gpu-temp-1: 0;
    in-out property <int> rpm-gpu-temp-2: 0;
    in-out property <int> rpm-gpu-temp-3: 0;
    in-out property <int> rpm-gpu-temp-4: 0;
    in-out property <int> rpm-gpu-temp-5: 0;
    in-out property <int> rpm-gpu-temp-6: 0;
    in-out property <int> rpm-gpu-temp-7: 0;
    in-out property <int> rpm-gpu-temp-8: 0;
    in-out property <int> rpm-gpu-temp-9: 0;
    in-out property <int> rpm-gpu-rpm-0: 0;
    in-out property <int> rpm-gpu-rpm-1: 0;
    in-out property <int> rpm-gpu-rpm-2: 0;
    in-out property <int> rpm-gpu-rpm-3: 0;
    in-out property <int> rpm-gpu-rpm-4: 0;
    in-out property <int> rpm-gpu-rpm-5: 0;
    in-out property <int> rpm-gpu-rpm-6: 0;
    in-out property <int> rpm-gpu-rpm-7: 0;
    in-out property <int> rpm-gpu-rpm-8: 0;
    in-out property <int> rpm-gpu-rpm-9: 0;
    in-out property <int> curve-cpu-t2: 60;
    in-out property <int> curve-cpu-d2: 45;
    in-out property <int> curve-cpu-t3: 80;
    in-out property <int> curve-cpu-d3: 65;
    in-out property <int> curve-gpu-t2: 60;
    in-out property <int> curve-gpu-d2: 40;
    in-out property <int> curve-gpu-t3: 80;
    in-out property <int> curve-gpu-d3: 60;
    in property <int> curve-current-cpu-t2: 60;
    in property <int> curve-current-cpu-d2: 45;
    in property <int> curve-current-cpu-t3: 80;
    in property <int> curve-current-cpu-d3: 65;
    in property <int> curve-current-gpu-t2: 60;
    in property <int> curve-current-gpu-d2: 40;
    in property <int> curve-current-gpu-t3: 80;
    in property <int> curve-current-gpu-d3: 60;
    in property <string> capabilities-text: @tr("--");
    in property <string> platform-text: @tr("--");
    in property <string> transport-device-path: "Not located";
    in property <string> renderer-text: "检测中";

    in property <bool> battery-present: false;
    in property <int> battery-percent: 0;
    in property <string> battery-status-text: @tr("--");
    in property <string> battery-ac-text: @tr("--");
    in property <string> battery-time-text: @tr("--");
    in property <string> battery-capacity-text: @tr("--");
    in property <string> battery-rate-text: @tr("--");

    in property <string> toggle-fn-text: @tr("Not initialized");
    in property <string> toggle-win-text: @tr("Not initialized");
    in property <string> toggle-swap-text: @tr("Not initialized");
    in property <string> toggle-hotkeys-text: @tr("Not initialized");
    in property <string> toggle-copilot-text: @tr("Not initialized");
    in property <bool> toggle-fn-value: false;
    in property <bool> toggle-fn-known: false;
    in property <bool> toggle-win-value: false;
    in property <bool> toggle-win-known: false;
    in property <bool> toggle-swap-value: false;
    in property <bool> toggle-swap-known: false;
    in property <bool> toggle-hotkeys-value: false;
    in property <bool> toggle-hotkeys-known: false;
    in property <bool> toggle-copilot-value: false;
    in property <bool> toggle-copilot-known: false;
    in property <string> extended-api-text: @tr("Unavailable");
    in property <string> gpu-switch-text: @tr("Unavailable");
    in property <int> gpu-current-mode: 0;
    in property <bool> gpu-igpu-supported: false;
    in property <bool> gpu-dgpu-supported: false;
    in property <bool> gpu-mshybrid-supported: false;
    in property <bool> gpu-dynamic-supported: false;
    in property <string> flexi-mode-text: @tr("Unavailable");
    in property <string> flexi-start-text: @tr("--");
    in property <string> flexi-stop-text: @tr("--");
    in property <string> flexi-ranges-text: @tr("--");
    in property <bool> flexi-ready: false;
    in property <int> flexi-mode: 0;
    in-out property <int> requested-flexi-mode: 0;
    in-out property <int> flexi-start-choice: 70;
    in-out property <int> flexi-stop-choice: 80;

    in property <bool> rgb-available: false;
    in property <bool> rgb-enabled: false;
    in property <int> rgb-brightness: 4;
    in property <int> rgb-effect: 8;
    in property <int> rgb-red: 0;
    in property <int> rgb-green: 0;
    in property <int> rgb-blue: 200;
    in property <bool> rgb-boot-effect: false;
    in property <bool> rgb-sleep-enabled: true;
    in property <int> rgb-sleep-hours: 0;
    in property <int> rgb-sleep-minutes: 0;
    in property <int> rgb-sleep-seconds: 30;
    in-out property <int> rgb-requested-red: 0;
    in-out property <int> rgb-requested-green: 0;
    in-out property <int> rgb-requested-blue: 200;
    in-out property <int> rgb-requested-brightness: 4;
    in-out property <int> rgb-requested-hours: 0;
    in-out property <int> rgb-requested-minutes: 0;
    in-out property <int> rgb-requested-seconds: 30;
    in-out property <bool> rgb-requested-sleep-enabled: true;
    in property <bool> rgb-sync-selection: false;
    in property <bool> camera-enabled: false;
    in property <bool> camera-known: false;
    in property <bool> touchpad-enabled: false;
    in property <bool> touchpad-known: false;
    in property <bool> airplane-enabled: false;
    in property <bool> airplane-known: false;
    in property <bool> low-refresh-supported: false;
    in property <bool> low-refresh-eligible: false;
    in property <bool> low-refresh-enabled: false;
    in property <bool> low-refresh-known: false;
    in property <bool> startup-enabled: false;
    in property <bool> display-care-available: false;
    in property <bool> display-care-panel-oled: false;
    in property <bool> taskbar-auto-hide: false;
    in property <bool> taskbar-transparency: false;
    in property <bool> display-dark-mode: false;
    in property <bool> screen-saver-enabled: false;
    in property <int> screen-saver-type: 0;
    in property <int> monitor-ac-minutes: 10;
    in property <int> monitor-dc-minutes: 10;
    in property <int> screen-saver-minutes: 10;
    in-out property <int> monitor-ac-requested: 10;
    in-out property <int> monitor-dc-requested: 10;
    in-out property <bool> screen-saver-requested-enabled: false;
    in-out property <int> screen-saver-requested-type: 0;
    in-out property <int> screen-saver-requested-minutes: 10;
    in property <[string]> flexikey-profile-names: [];
    in property <int> flexikey-active-index: -1;
    in property <string> flexikey-active-title: "FlexiKey";
    in property <string> flexikey-summary: "";
    in property <string> flexikey-status: "";
    in property <string> flexikey-engine-status: "";
    in property <string> flexikey-path: "";
    in-out property <string> flexikey-profile-name: "";
    in-out property <bool> flexikey-delete-armed: false;
    in property <[string]> flexikey-binding-labels: [];
    in property <bool> flexikey-keyboard-enabled: true;
    in property <bool> flexikey-mouse-enabled: true;
    in-out property <bool> flexikey-editor-open: false;
    in-out property <int> flexikey-editor-binding-index: -1;
    in-out property <int> flexikey-editor-device: 1;
    in-out property <string> flexikey-editor-key-code: "";
    in-out property <string> flexikey-editor-key-name: "";
    in-out property <int> flexikey-editor-action: 1;
    in-out property <string> flexikey-editor-value: "";
    in-out property <string> flexikey-editor-status: "";
    in-out property <bool> flexikey-capture-armed: false;
    in property <bool> caps-supported: true;
    in property <bool> num-supported: true;
    in property <bool> scroll-supported: true;
    in property <int> display-brightness: 50;
    in-out property <int> display-brightness-requested: 50;
    in property <int> blue-light-level: 0;
    in-out property <int> blue-light-requested: 0;
    in property <int> audio-volume: 50;
    in-out property <int> audio-volume-requested: 50;
    in property <bool> audio-muted: false;
    in property <bool> audio-known: false;
    in property <bool> anti-dust-supported: false;
    in property <bool> anti-dust-running: false;
    in-out property <bool> anti-dust-enabled: false;
    in-out property <bool> anti-dust-resume: true;
    in-out property <int> anti-dust-day: 6;
    in-out property <int> anti-dust-hour: 0;

    callback select-page(int);
    callback apply-power(int);
    callback apply-fan(int);
    callback set-quick-toggle(int, bool);
    callback apply-low-refresh(bool);
    callback set-startup(bool);
    callback set-display-toggle(int, bool);
    callback apply-monitor-timeouts(int, int);
    callback apply-screen-saver(bool, int, int);
    callback reload-flexikey();
    callback select-flexikey-profile(int);
    callback new-flexikey-profile();
    callback rename-flexikey-profile(string);
    callback delete-flexikey-profile();
    callback set-flexikey-device-enabled(int, bool);
    callback open-flexikey-editor(int);
    callback close-flexikey-editor();
    callback save-flexikey-editor(int, int, string, string, int, string);
    callback delete-flexikey-binding(int);
    callback capture-flexikey-trigger();
    callback cancel-flexikey-capture();
    callback apply-fan-curve();
    callback refresh-now();
    callback clear-status();
    callback set-language(bool);
    callback set-theme(bool);
    callback apply-quiet(bool);
    callback cancel-quiet();
    callback apply-gpu-mode(int);
    callback apply-flexi-charger(int, int, int);
    callback apply-rgb-brightness(int);
    callback apply-rgb-color(int, int, int);
    callback apply-rgb-effect(int);
    callback apply-rgb-sleep-timer(bool, int, int, int);
    callback apply-rgb-boot-effect(bool);
    callback apply-camera(bool);
    callback apply-touchpad(bool);
    callback apply-airplane(bool);
    callback send-lock-key(int);
    callback apply-brightness(int);
    callback apply-blue-light(int);
    callback apply-volume(int);
    callback apply-mute(bool);
    callback apply-slow-fan(bool);
    callback apply-turbo-fan(bool);
    callback apply-rpm-curve();
    callback apply-fan-offset(int);
    callback run-anti-dust();
    callback apply-anti-dust-schedule(bool, bool, int, int);

    HorizontalLayout {
        Rectangle {
            width: 204px;
            background: Palette.rail-gradient;
            border-width: 1px;
            border-color: Palette.line;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 18px;
                padding-bottom: 16px;
                spacing: 5px;

                HorizontalLayout {
                    height: 52px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 34px;
                        height: 34px;
                        source: @image-url("../../../assets/neo_control_logo.svg");
                        image-fit: contain;
                    }
                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;
                        Text {
                            text: @tr("NEO");
                            color: Palette.text;
                            font-family: "Bahnschrift";
                            font-size: 15px;
                            font-weight: 600;
                            letter-spacing: 1.2px;
                        }
                        Text {
                            text: @tr("CONTROL");
                            color: Palette.text-dim;
                            font-family: "Cascadia Mono";
                            font-size: 9px;
                            letter-spacing: 1.6px;
                        }
                    }
                }

                Rectangle { height: 10px; }
                HorizontalLayout {
                    padding-left: 12px;
                    MicroLabel { text: @tr("WORKSPACE"); }
                }
                Rectangle { height: 3px; }
                NavItem { label: @tr("Overview"); glyph: 0; selected: root.navigation-page == 0; clicked => { root.select-page(0); } }
                NavItem { label: @tr("Performance"); glyph: 1; selected: root.navigation-page == 1; clicked => { root.select-page(1); } }
                NavItem { label: @tr("Cooling"); glyph: 2; selected: root.navigation-page == 2; clicked => { root.select-page(2); } }
                NavItem { label: @tr("Fan curve"); glyph: 2; selected: root.navigation-page == 8; clicked => { root.select-page(8); } }
                NavItem { label: @tr("Battery"); glyph: 3; selected: root.navigation-page == 3; clicked => { root.select-page(3); } }
                NavItem { label: @tr("System"); glyph: 4; selected: root.navigation-page == 4; clicked => { root.select-page(4); } }
                NavItem { label: @tr("Lighting"); glyph: 6; selected: root.navigation-page == 6; clicked => { root.select-page(6); } }
                NavItem { label: @tr("FlexiKey"); glyph: 7; selected: root.navigation-page == 9; clicked => { root.select-page(9); } }
                NavItem { label: @tr("Input & I/O"); glyph: 7; selected: root.navigation-page == 7; clicked => { root.select-page(7); } }
                NavItem { label: @tr("Display care"); glyph: 8; selected: root.navigation-page == 10; clicked => { root.select-page(10); } }
                Rectangle { height: 12px; }
                NavItem { label: @tr("Settings"); glyph: 5; selected: root.navigation-page == 5; clicked => { root.select-page(5); } }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 82px;
                    border-radius: 9px;
                    background: Palette.surface-hi;
                    border-width: 1px;
                    border-color: Palette.line;
                    VerticalLayout {
                        padding: 11px;
                        spacing: 7px;
                        HorizontalLayout {
                            spacing: 7px;
                            cross-axis-alignment: center;
                            SignalDot { active: root.transport-ready; tone: root.transport-ready ? Palette.green : Palette.amber; }
                            Text {
                                text: root.transport-label;
                                color: Palette.text-dim;
                                font-family: "Bahnschrift";
                                font-size: 11px;
                                font-weight: 500;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: root.transport-detail;
                            color: Palette.text-faint;
                            font-family: "Bahnschrift";
                            font-size: 10px;
                            wrap: word-wrap;
                            max-lines: 2;
                        }
                    }
                }
            }
        }

        Rectangle {
            background: Palette.base;


            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 62px;
                    background: Palette.rail-gradient;

                    Text {
                        text: @tr("NEO CONTROL");
                        color: Palette.text;
                        font-family: "Bahnschrift";
                        font-size: 17px;
                        font-weight: 500;
                        letter-spacing: 2.4px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        x: 22px;
                        y: 0;
                        height: parent.height;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        SignalDot { active: root.transport-ready; tone: root.transport-ready ? Palette.green : Palette.amber; }
                        MicroLabel {
                            text: root.transport-ready ? @tr("LOCAL HARDWARE") : @tr("HARDWARE OFFLINE");
                            color: root.transport-ready ? Palette.green : Palette.amber;
                        }
                    }

                    HorizontalLayout {
                        x: parent.width - 130px;
                        y: 0;
                        width: 112px;
                        height: parent.height;
                        spacing: 8px;
                        alignment: end;

                        ChromeButton {
                            width: 104px;
                            emphasized: true;
                            enabled: !root.busy;
                            text: root.busy
                                ? (root.language-zh ? "刷新中" : "Working")
                                : (root.language-zh ? "刷新" : "Refresh");
                            clicked => { root.refresh-now(); }
                        }
                    }
                }

                Hairline {}

                if root.status-message != "" : Rectangle {
                        height: 34px;
                        background: root.status-tone == 2 ? Palette.red-soft : (root.status-tone == 1 ? Palette.green-soft : Palette.panel-hover);
                        border-width: 1px;
                        border-color: root.status-tone == 2 ? Palette.red : (root.status-tone == 1 ? Palette.green : Palette.line);
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 18px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            SignalDot {
                                width: 5px;
                                height: 5px;
                                border-radius: 3px;
                                tone: root.status-tone == 2 ? Palette.red : (root.status-tone == 1 ? Palette.green : Palette.cyan);
                            }
                            Text {
                                text: root.status-message;
                                color: Palette.text-dim;
                                font-family: "Bahnschrift";
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                width: 54px;
                                height: 24px;
                                Text {
                                    text: @tr("Dismiss");
                                    color: Palette.text-faint;
                                    font-family: "Bahnschrift";
                                    font-size: 10px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-status(); }
                                }
                            }
                        }
                    }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    page-surface := Rectangle {
                        y: root.page-shift * 1px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.page-opacity;
                        transform-scale-x: root.page-scale * 100%;
                        transform-scale-y: root.page-scale * 100%;
                        animate opacity { duration: root.page-fade-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
                        animate y { duration: root.page-motion-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
                        animate transform-scale-x { duration: root.page-motion-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
                        animate transform-scale-y { duration: root.page-motion-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
                        page-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-width: self.width;
                            content-height: max(self.height, page-layout.preferred-height);

                            page-layout := VerticalLayout {
                                width: parent.width;
                                height: max(self.preferred-height, page-scroll.height);
                                padding-left: 28px;
                                padding-right: 28px;
                                padding-top: 24px;
                                padding-bottom: 24px;
                                spacing: 18px;

                        // ------------------------------------------------- Overview
                        if root.selected-page == 0 : OverviewPage {
                            selected-page: root.selected-page;
