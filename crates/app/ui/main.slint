            }
        }

    Rectangle {
        x: 204px + root.page-veil-x * (root.width - 204px);
        y: 60px;
        width: root.width - 204px;
        height: root.height - 60px;
        visible: root.page-veil-visible;
        background: Palette.page-veil-gradient;
        animate x { duration: root.page-veil-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
        Rectangle {
            x: parent.width - 3px;
            width: 3px;
            height: parent.height;
            background: Palette.cyan;
            opacity: 0.82;
        }
        Rectangle {
            width: parent.width;
            height: 1px;
            background: Palette.cyan;
            opacity: 0.32;
        }
        Rectangle {
            x: parent.width * 0.45;
            y: parent.height * 0.18;
            width: parent.width * 0.45;
            height: parent.height * 0.64;
            background: @radial-gradient(circle, Palette.cyan.with-alpha(0.13) 0%, transparent 68%);
        }
        if root.page-veil-visible : TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Palette.dark ? #12151E : #E8ECF3;
        opacity: root.theme-flash;
        visible: self.opacity > 0.001;
        animate opacity { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }

    QuietDialog {
        quiet-dialog-open <=> root.quiet-dialog-open;
        apply-quiet(disable) => { root.apply-quiet(disable); }
        cancel-quiet => { root.cancel-quiet(); }
    }

    FlexiKeyEditor {
        flexikey-editor-open <=> root.flexikey-editor-open;
        flexikey-editor-binding-index <=> root.flexikey-editor-binding-index;
        flexikey-editor-device <=> root.flexikey-editor-device;
        flexikey-editor-key-code <=> root.flexikey-editor-key-code;
        flexikey-editor-key-name <=> root.flexikey-editor-key-name;
        flexikey-editor-action <=> root.flexikey-editor-action;
        flexikey-editor-value <=> root.flexikey-editor-value;
        flexikey-editor-status <=> root.flexikey-editor-status;
        flexikey-capture-armed <=> root.flexikey-capture-armed;
        close-flexikey-editor => { root.close-flexikey-editor(); }
        save-flexikey-editor(index, device, key-code, key-name, action, value) => {
            root.save-flexikey-editor(index, device, key-code, key-name, action, value);
        }
        delete-flexikey-binding(index) => { root.delete-flexikey-binding(index); }
        capture-flexikey-trigger => { root.capture-flexikey-trigger(); }
        cancel-flexikey-capture => { root.cancel-flexikey-capture(); }
    }


